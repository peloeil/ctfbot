# 必須
DISCORD_TOKEN=
GUILD_ID=

# 任意（0 で無効）
BOT_CHANNEL_ID=0
CTFTEAM_CATEGORY_ID=0
CTFTEAM_ARCHIVE_CATEGORY_ID=0
CTFTEAM_ROLE_CHANNEL_ID=0
CTFTIME_CHANNEL_ID=0
ALPACAHACK_CHANNEL_ID=0
ALPACAHACK_MENTION_ID=0
ADMIN_ROLE_ID=0
SUDOER_ROLE_ID=0
TIMES_CATEGORY_ID=0

# デフォルトあり
TIMEZONE=Asia/Tokyo
LOG_LEVEL=INFO
DATABASE_PATH=ctfbot.db
ALPACAHACK_DAILY_TIME=00:05
ALPACAHACK_SOLVE_TIME=23:00
CTFTIME_NOTIFICATION_TIME=09:00
CTFTIME_WINDOW_DAYS=14
CTFTIME_EVENT_LIMIT=20
CTFTIME_USER_AGENT="ctfbot/2.0 (+discord)"
SUDO_DURATION_MINUTES=30

# AI チャット（API キー未設定で無効。URL とモデルは接続先に合わせて変更可能）
AI_CHAT_API_KEY=
AI_CHAT_API_URL=https://api.ai.sakura.ad.jp/v1/chat/completions
AI_CHAT_MODEL=preview/gemma-4-31B-it

# VC 読み上げ（URL 未設定で無効。有効にすると Message Content Intent が必須）
TTS_VOICEVOX_URL=
# 自動割り当てと選択候補。VOICEVOX は使った声のモデルを保持するため、増やすとメモリ使用量が増える
TTS_SPEAKER_IDS=3,2,14,11,13
TTS_MAX_CHARS=200
TTS_SPEED_SCALE=1.5
